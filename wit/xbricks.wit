package xbricks:plugins@0.1.0;

/// The interface for nodes that route, drop, or filter existing traffic.
interface inspector {
    /// Called once at startup with admin key/value data from the node config (wasm_data field)
    init-data: func(data: list<tuple<string, string>>);

    /// Takes a batch of PDUs, returns routing actions (Route IDs / Drop / Telemetry flags)
    inspect-batch: func(batch-bytes: list<u8>, partition-offset: u32) -> list<u32>;
}

/// The interface for nodes that inspect and modify packets, e.g. running a TCP stack.
interface packet-engine {
    /// Called once at startup with admin key/value data from the node config (wasm_data field)
    init-data: func(data: list<tuple<string, string>>);

    /// Takes a batch of PDUs, returns routing actions (Route IDs / Drop / Telemetry flags) and packet lengths
    process-batch: func(batch-bytes: list<u8>, partition-offset: u32) -> tuple<list<u32>, list<u32>>;

    /// Process timers and return the number of frames that are needed for the timeouts
    process-timers: func(current-tsc: u64) -> u32;

}

/// The interface for nodes that generate new synthetic traffic.
interface generator {
    /// Called once at startup with admin key/value data from the node config (wasm_data field)
    /// and to set the worker ID and internal sequence state
    init-data: func(data: list<tuple<string, string>>, worker-id: u32);

    // Define aliases for readability
    type ipv4-addr = tuple<u8, u8, u8, u8>;
    type mac-addr = tuple<u8, u8, u8, u8, u8, u8>;
    set-dst: func(mac: mac-addr, ip: ipv4-addr);

    /// Takes an empty batch of PDUs, writes headers, returns packet lengths
    generate-batch: func(batch-bytes: list<u8>, partition-offset: u32) -> list<u32>;
}

/// The World definition for a Filter/Router plugin
world filter-plugin {
    export inspector;
}

/// The World definition for a Generator plugin
world generator-plugin {
    export generator;
}

/// The World definition for a Generator plugin
world engine-plugin {
    export packet-engine;
}