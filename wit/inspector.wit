package xbricks:router@0.1.0;

interface inspector {
    // We pass the entire Batch as raw bytes.
    // Wasm modifies the flags in-place and returns the bytes back.
    // The partition offset is the offset of the wasm memory start (address 0) in the Umem.
    inspect-batch: func(batch-bytes: list<u8>, partition-offset: u32) -> list<u32>;
}

/// The definition of a standard xbricks filter plugin
world filter-plugin {
    export inspector;
}