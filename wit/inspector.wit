package xbricks:router@0.1.0;

interface inspector {
    enum verdict {
        forward,
        drop,
        exception
    }

    // Process an entire batch of packets at once.
    // The host passes lists of offsets and lengths relative to the UMEM.
    // The plugin returns a list of verdicts (one for each packet).
    inspect-batch: func(offsets: list<u64>, lengths: list<u32>) -> list<verdict>;
}

/// The definition of a standard xbricks filter plugin
world filter-plugin {
    export inspector;
}